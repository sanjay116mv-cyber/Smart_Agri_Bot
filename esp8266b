  server.send(200, "text/html", dashboardHTML);
}

void setup() {
  Serial.begin(115200);
  
  pinMode(MQ2_POWER_PIN, OUTPUT);
  pinMode(SOIL_POWER_PIN, OUTPUT);
  pinMode(LDR_PIN, INPUT);

  dht.begin();
  if (!bmp.begin()) {
    // BMP180 sensor initialization check
  } else {
    baselinePressure = bmp.readPressure() / 100.0;
  }

  probeServo.attach(14); // D5
  probeServo.write(RETRACT_ANGLE);

  // Setup networking profile as a client to connect with ESP32-CAM AP
  WiFi.begin("SmartAgribot", "Password123");
  
  // Set Static IP configuration matching the network architecture
  IPAddress ip(192.168.4.2);
  IPAddress gateway(192.168.4.1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.config(ip, gateway, subnet);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  server.on("/", handleDashboard);
  server.on("/data", handleDataJSON);
  server.on("/deploy", handleDeploy);
  server.begin();
}

void loop() {
  server.handleClient();

  // Run Non-blocking periodic hardware polls
  static unsigned long lastSensorPoll = 0;
  if (millis() - lastSensorPoll > 3000) {
    lastSensorPoll = millis();

    temperature = dht.readTemperature();
    humidity = dht.readHumidity();
    
    if (isnan(temperature) || isnan(humidity)) {
      temperature = 28.5; // Fail-safe default
      humidity = 60.0;
    }

    if (bmp.begin()) {
      pressure = bmp.readPressure() / 100.0;
      altitude = bmp.readAltitude();
    }

    isDaylight = (digitalRead(LDR_PIN) == LOW); // LDR is Active LOW
    
    performMultiplexedReadings();
    calculateVPD();
    processWeatherForecast();
  }
}
