#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Servo.h>
#include <DHT.h>
#include <Wire.h>
#include <Adafruit_BMP085.h>

// Sensor Pin Definitions
#define DHTPIN 12             // D6 on NodeMCU
#define DHTTYPE DHT22
#define MQ2_POWER_PIN 13      // D7 (Switches MQ2 Power)
#define SOIL_POWER_PIN 15     // D8 (Switches Soil Moisture Power)
#define LDR_PIN 0             // D3 Digital Threshold input
#define ANALOG_PIN A0         // Shared A0 Line

DHT dht(DHTPIN, DHTTYPE);
Adafruit_BMP085 bmp;
Servo probeServo;
ESP8266WebServer server(81);  // Sensor hub hosted on port 81

// Global Environment State Variables
float temperature = 0.0;
float humidity = 0.0;
float pressure = 1013.25;
float altitude = 0.0;
float baselinePressure = 1013.25;
int gasRaw = 0;
int soilMoistureRaw = 0;
float soilMoisturePercent = 0.0;
bool isDaylight = true;
float vpd = 0.0;
String rainWarning = "No Rain Threat Detected";
String vpdRisk = "VPD Within Normal Parameters";

// Servo Positions
const int RETRACT_ANGLE = 0;
const int DEPLOY_ANGLE = 90;

// Algorithm: Vapor Pressure Deficit (VPD)
void calculateVPD() {
  if (temperature <= 0) return;
  // Saturation Vapor Pressure (es) in kPa using Tetens equation
  float es = 0.61078 * exp((17.27 * temperature) / (temperature + 237.3));
  // Actual Vapor Pressure (ea) in kPa
  float ea = es * (humidity / 100.0);
  vpd = es - ea;

  if (vpd > 1.2) {
    vpdRisk = "High Transpiration Risk: Optimize Root Irrigation";
  } else if (vpd < 0.4) {
    vpdRisk = "High Pathogen Risk: Excessive Humidity / Fungal Risk";
  } else {
    vpdRisk = "Normal Growth Parameters";
  }
}

// Algorithm: Sliding Window Rainfall Forecasting (dP/dt)
void processWeatherForecast() {
  float currentPressure = bmp.readPressure() / 100.0; // convert to hPa
  // If local pressure drops quickly below the sliding hourly average and humidity is high
  float diff = currentPressure - baselinePressure;
  if (diff < -1.0 && humidity > 75.0) {
    rainWarning = "CRITICAL: Heavy Rain Forecasted in 3-5 Hours!";
  } else {
    rainWarning = "Stable Atmospheric Conditions";
  }
}

// Function: Safe Sequenced Single-A0 Readings
void performMultiplexedReadings() {
  // Read MQ2 Sensor
  digitalWrite(MQ2_POWER_PIN, HIGH);
  digitalWrite(SOIL_POWER_PIN, LOW);
  delay(50); // Let voltage settle
  gasRaw = analogRead(ANALOG_PIN);
  digitalWrite(MQ2_POWER_PIN, LOW);

  // Read Soil Moisture (We read this when deployed, but provide manual trigger)
  digitalWrite(SOIL_POWER_PIN, HIGH);
  delay(50); // Let voltage settle
  soilMoistureRaw = analogRead(ANALOG_PIN);
  digitalWrite(SOIL_POWER_PIN, LOW);

  // Calibration mapping: Wet threshold (approx 350) and Dry threshold (approx 850)
  soilMoisturePercent = map(soilMoistureRaw, 850, 350, 0, 100);
  soilMoisturePercent = constrain(soilMoisturePercent, 0, 100);
}

// Servo Actuation deployment sequence
void runDeploymentCycle() {
  probeServo.write(DEPLOY_ANGLE);
  delay(2000); // Wait for servo to insert the capacitive probe

  // Take deep reading of soil moisture
  digitalWrite(SOIL_POWER_PIN, HIGH);
  delay(100);
  soilMoistureRaw = analogRead(ANALOG_PIN);
  digitalWrite(SOIL_POWER_PIN, LOW);
  
  soilMoisturePercent = map(soilMoistureRaw, 850, 350, 0, 100);
  soilMoisturePercent = constrain(soilMoisturePercent, 0, 100);

  // Auto-retract to protect sensor probe during navigation
  probeServo.write(RETRACT_ANGLE);
  delay(1500); 
}

// HTTP Response for ESP32 Dashboard
void handleDeploy() {
  runDeploymentCycle();
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "text/plain", String(soilMoisturePercent));
}

// Root JSON data endpoint for asynchronous UI fetches
void handleDataJSON() {
  String json = "{";
  json += "\"temp\":" + String(temperature) + ",";
  json += "\"humidity\":" + String(humidity) + ",";
  json += "\"pressure\":" + String(pressure) + ",";
  json += "\"gas\":" + String(gasRaw) + ",";
  json += "\"soil\":" + String(soilMoisturePercent) + ",";
  json += "\"vpd\":" + String(vpd) + ",";
  json += "\"daylight\":" + String(isDaylight ? "true" : "false") + ",";
  json += "\"rain\":\"" + rainWarning + "\",";
  json += "\"vpdRisk\":\"" + vpdRisk + "\"";
  json += "}";
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "application/json", json);
}

// Dashboard Webpage
